
# DAZ Configuration
#
# Set this variable to the full path of your DAZ Studio executable (DAZStudio.exe)
DAZ_STUDIO_EXE_PATH=CHANGEME

#
# These values are used to connect to your DAZ CMS PostgreSQL database. You should not
# need to change these unless you have a custom setup.
#
DB_NAME=Content
DB_USER=dzcms
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=17237

#
# The local path where the ChromaDB vector store will be saved. This can be any directory you choose,
# but the default value will work fine
#
CHROMA_PATH="chroma_db"

#
# The name of the collection within ChromaDB. You can change this if you want to keep multiple collections,
# but the default value will work fine
#
CHROMA_COLLECTION="daz_products2"

#
# Path to the local SQLite database file that will store enriched product data. This can be any file path you choose,
# but the default value will work fine
#
SQLITE_DB_PATH = 'enriched_products.db'
SQLITE_TABLE_NAME = 'enriched_products'
BATCH_SIZE = 1024

#
# Embedding model settings (ONNX Runtime, CPU-only).
# The model (BAAI/bge-large-en-v1.5) is exported to ONNX on first run and cached locally.
#
# EMBEDDING_MODEL_DIR  — override the local cache path (default: models/bge-large-en-v1.5/)
# EMBEDDING_BATCH_SIZE — texts per ONNX inference call (default: 32; lower = less memory)
#
# EMBEDDING_MODEL_DIR=models/bge-large-en-v1.5
# EMBEDDING_BATCH_SIZE=32

#
# Japanese query translation
# --------------------------
# The index is English, so a Japanese query is translated to English before it is
# embedded. Without this, '和室の背景' reproduces 3 of the 10 results its English
# phrasing finds; with it, 10 of 10 (python check_crosslingual.py).
#
# Export the model once (~360 MB, runs on CPU, adds ~0.05s to a Japanese query):
#
#   python export_translation_model.py     # -> models/fugumt-ja-en/
#
# QUERY_TRANSLATION          'auto' (default), 'on' or 'off'. 'auto' translates only
#                            when the model has been exported; queries with no
#                            Japanese characters are never translated either way.
# QUERY_TRANSLATION_MODEL_ID HuggingFace model ID (default: staka/fugumt-ja-en)
# QUERY_TRANSLATION_MODEL_DIR  override the local path (default: models/<slug>/)
#
# QUERY_TRANSLATION=auto
# QUERY_TRANSLATION_MODEL_ID=staka/fugumt-ja-en
#
# QUERY_TRANSLATION_BACKEND  'onnx' (default) or 'ctranslate2'.
#   onnx        — staka/fugumt-ja-en, ~360 MB, ~30 ms. Strong on everyday language.
#   ctranslate2 — sugoi-v4, ~1.1 GB, ~130 ms. Trained with the adult vocabulary the
#                 general-purpose ja-en corpora filter out: fugumt renders 緊縛 as
#                 'tight-knit', 鞭 as 'sputum' and セックス as 'sleek', each sending
#                 the search somewhere unrelated; sugoi gives Bondage / Whip / Sex.
#                 Licensed for research use only (NTT/JParaCrawl) and never bundled.
#                 pip install ctranslate2, then:
#                   python export_translation_model.py --backend ctranslate2
#
# Either backend covers for the other: if the configured one has no model, the
# loader falls back rather than switching translation off.
#
# QUERY_GLOSSARY_PATH  Japanese terms mapped straight to English, bypassing the
#                      model for words it gets wrong (default:
#                      query_glossary.ja-en.json). Matched on the whole query.
# QUERY_TRANSLATION_BACKEND=onnx
